{
  "name": "intelligent-decisions-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:chargeback-studio": "esbuild src/chargeback-supabase-browser.js --bundle --minify --format=iife --target=es2022 --outfile=public/projects/chargeback-studio/supabase.js",
    "build:revenue-leak-finder": "esbuild src/revenue-leak-finder/entry.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --outfile=public/projects/revenue-leak-finder/revenue-leak-finder.js",
    "build:bidlens": "esbuild src/bidlens/entry.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --outfile=public/projects/bidlens/bidlens.js",
    "build:scopefence": "esbuild src/scopefence/entry.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --outfile=public/projects/scopefence/scopefence.js",
    "build": "npm run build:chargeback-studio && npm run build:revenue-leak-finder && npm run build:bidlens && npm run build:scopefence",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "4.131.0"
  }
}
